---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('posts', ({ data }) => !data.draft)

const tagMap: Record<string, number> = {}
allPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagMap[tag] = (tagMap[tag] || 0) + 1
  })
})

const tags = Object.entries(tagMap).sort((a, b) => b[1] - a[1])
---

<BaseLayout title="Tags">
  <div class="mx-auto max-w-3xl px-6 py-10">
    <h1 class="fade-in-up mb-8 text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-100">
      Tags
    </h1>
    <div class="fade-in-up flex flex-wrap gap-3" style="animation-delay: 100ms">
      {tags.map(([tag, count]) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}`}
          class="inline-flex items-center gap-1.5 rounded-full border border-stone-200 px-4 py-2 text-sm font-medium text-stone-600 transition-colors hover:border-stone-400 hover:text-stone-900 dark:border-stone-800 dark:text-stone-400 dark:hover:border-stone-600 dark:hover:text-stone-100"
        >
          #{tag}
          <span class="text-xs text-stone-400 dark:text-stone-600">{count}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
