---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PostCard from '../../../components/PostCard.astro'
import { getCollection } from 'astro:content'
import { useTranslations } from '../../../i18n/utils'

const lang = 'zh-CN'
const t = useTranslations(lang)

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 10)
---

<BaseLayout title={t('posts.title')} lang={lang}>
  <div class="mx-auto max-w-3xl px-6 py-10">
    <h1 class="fade-in-up mb-8 text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-100">
      {t('posts.title')}
    </h1>

    <div class="grid gap-3">
      {allPosts.map((post) => (
        <PostCard
          title={post.data.title}
          href={`/zh/posts/${post.id.replace(/\.md$/, '')}`}
          date={post.data.date}
          tags={post.data.tags}
          excerpt={post.data.excerpt}
          lang={lang}
        />
      ))}
    </div>

    <div class="mt-8 text-center">
      <a href="/zh/posts/2" class="text-sm text-stone-500 transition-colors hover:text-stone-700 dark:text-stone-400 dark:hover:text-stone-200">
        {t('posts.older')}
      </a>
    </div>
  </div>
</BaseLayout>
