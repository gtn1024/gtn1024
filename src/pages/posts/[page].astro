---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths({ paginate }) {
  const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  return paginate(allPosts, { pageSize: 10 })
}

const { page } = Astro.props
---

<BaseLayout title="Posts">
  <div class="mx-auto max-w-3xl px-6 py-10">
    <h1 class="fade-in-up mb-8 text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-100">
      Posts
    </h1>

    <div class="grid gap-3">
      {page.data.map((post) => (
        <PostCard
          title={post.data.title}
          href={`/posts/${post.id.replace(/\.md$/, '')}`}
          date={post.data.date}
          tags={post.data.tags}
          excerpt={post.data.excerpt}
        />
      ))}
    </div>

    {page.lastPage > 1 && (
      <div class="mt-10 flex items-center justify-center gap-4 text-sm">
        {page.url.prev && (
          <a href={page.url.prev === '/posts' ? '/posts' : page.url.prev} class="rounded border border-stone-200 px-3 py-1.5 text-stone-600 transition-colors hover:border-stone-400 dark:border-stone-800 dark:text-stone-400 dark:hover:border-stone-600">
            &larr; Newer
          </a>
        )}
        <span class="text-stone-400 dark:text-stone-600">
          {page.currentPage} / {page.lastPage}
        </span>
        {page.url.next && (
          <a href={page.url.next} class="rounded border border-stone-200 px-3 py-1.5 text-stone-600 transition-colors hover:border-stone-400 dark:border-stone-800 dark:text-stone-400 dark:hover:border-stone-600">
            Older &rarr;
          </a>
        )}
      </div>
    )}
  </div>
</BaseLayout>
