---
import type { Lang } from '../i18n/utils'
import { useTranslations } from '../i18n/utils'

export interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)

const skills = [
  { label: t('home.skills.lang'), items: ['Java', 'Kotlin', 'TypeScript', 'JavaScript', 'Cangjie'] },
  { label: t('home.skills.frameworks'), items: ['Spring Boot', 'React', 'Vue', 'Node.js'] },
]

const phrases = lang === 'en'
  ? ['Open Source Enthusiast', 'Software Developer']
  : ['开源爱好者', '软件开发者']
const phrasesJson = JSON.stringify(phrases)
---

<div class="flex min-h-[calc(100vh-10rem)] items-center justify-center px-6">
  <div class="w-full max-w-xl space-y-8">
    <header class="fade-in-up flex items-center gap-5" style="animation-delay: 80ms">
      <img
        src="https://github.com/gtn1024.png"
        alt="Taoning Ge"
        class="h-20 w-20 rounded-full shadow-lg ring-2 ring-stone-200/80 dark:ring-stone-700/50 md:h-24 md:w-24"
      />
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-100 md:text-4xl">
          Taoning Ge
        </h1>
        <p class="mt-1 text-stone-500 dark:text-stone-400" id="tagline"></p>
      </div>
    </header>
    <div class="fade-in-up space-y-4 text-stone-600 dark:text-stone-400" style="animation-delay: 180ms">
      <p>
        {t('home.intro')}
      </p>
      {skills.map(({ label, items }) => (
        <div>
          <h2 class="mb-1 text-sm font-semibold uppercase tracking-wider text-stone-900 dark:text-stone-100">{label}</h2>
          <div class="flex flex-wrap gap-2 pt-2">
            {items.map((item) => (
              <span class="rounded-md bg-stone-100/80 px-3 py-1 text-sm text-stone-800 dark:bg-stone-700/50 dark:text-stone-200">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline define:vars={{ phrases }}>
  const el = document.getElementById('tagline')
  let phraseIdx = 0, charIdx = 0, deleting = false
  function type() {
    const phrase = phrases[phraseIdx]
    if (!deleting) {
      charIdx++
      if (charIdx > phrase.length) { deleting = true; setTimeout(type, 2000); return }
    } else {
      charIdx--
      if (charIdx < 0) { deleting = false; phraseIdx = (phraseIdx + 1) % phrases.length; charIdx = 0; setTimeout(type, 400); return }
    }
    el.textContent = phrase.substring(0, charIdx) + (charIdx < phrase.length ? '|' : '')
    setTimeout(type, deleting ? 40 : 80)
  }
  setTimeout(type, 600)
</script>
