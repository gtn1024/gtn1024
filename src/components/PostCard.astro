---
export interface Props {
  title: string
  href: string
  date: Date
  tags?: string[]
  excerpt?: string
}

const { title, href, date, tags = [], excerpt } = Astro.props

function formatDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
}
---

<a
  href={href}
  class="group block rounded-lg border border-stone-200/80 p-5 transition-all hover:border-stone-300 hover:shadow-sm dark:border-stone-800/80 dark:hover:border-stone-700"
>
  <div class="mb-2 flex items-center gap-3 text-xs text-stone-500 dark:text-stone-400">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {tags.slice(0, 2).map((tag) => (
      <span class="text-stone-400 dark:text-stone-600">#{tag}</span>
    ))}
  </div>
  <h3 class="text-base font-semibold text-stone-900 transition-colors group-hover:text-accent-700 dark:text-stone-100 dark:group-hover:text-accent-400">
    {title}
  </h3>
  {excerpt && (
    <p class="mt-1.5 line-clamp-2 text-sm text-stone-500 dark:text-stone-400">{excerpt}</p>
  )}
</a>
